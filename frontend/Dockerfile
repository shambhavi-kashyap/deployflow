# Step 1: Use a lightweight Nginx image to serve static web files
FROM nginx:alpine

# Step 2: Copy the static HTML/JS/CSS files generated by Vite into Nginx's web root
COPY dist /usr/share/nginx/html

# Step 3: Expose port 80 for web traffic
EXPOSE 80

# Step 4: Run Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]